  "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 12mm;\r\n    }\r\n\r\n    .df-header {\r\n        border-bottom: 3px solid #0f766e;\r\n        padding-bottom: 10px;\r\n        margin-bottom: 18px;\r\n    }\r\n\r\n    .df-company {\r\n        font-size: 22px;\r\n        font-weight: 800;\r\n        color: #123047;\r\n        letter-spacing: 1px;\r\n    }\r\n\r\n    .df-title {\r\n        font-size: 16px;\r\n        font-weight: 700;\r\n        color: #0f766e;\r\n        margin-top: 4px;\r\n    }\r\n\r\n    .df-subtitle {\r\n        font-size: 9px;\r\n        color: #64748b;\r\n        margin-top: 3px;\r\n    }\r\n\r\n    .df-section {\r\n        background: #123047;\r\n        color: white;\r\n        padding: 7px 10px;\r\n        font-size: 10px;\r\n        font-weight: 700;\r\n        margin-top: 15px;\r\n        margin-bottom: 8px;\r\n        text-transform: uppercase;\r\n        letter-spacing: .5px;\r\n    }\r\n\r\n    .df-info {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .df-info td {\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px;\r\n        font-size: 9px;\r\n    }\r\n\r\n    .df-label {\r\n        font-weight: 700;\r\n        color: #475569;\r\n        width: 20%;\r\n        background: #f8fafc;\r\n    }\r\n\r\n    .df-box {\r\n        border: 1px solid #d9e2e8;\r\n        padding: 10px;\r\n        font-size: 9px;\r\n        line-height: 1.5;\r\n        min-height: 55px;\r\n    }\r\n\r\n    .df-signatures {\r\n        width: 100%;\r\n        margin-top: 35px;\r\n    }\r\n\r\n    .df-signatures td {\r\n        width: 33.33%;\r\n        text-align: center;\r\n        font-size: 8px;\r\n        color: #475569;\r\n        padding-top: 25px;\r\n    }\r\n\r\n    .df-sign-line {\r\n        border-top: 1px solid #64748b;\r\n        margin: 0 15px 5px;\r\n    }\r\n\r\n    .df-footer {\r\n        margin-top: 25px;\r\n        padding-top: 8px;\r\n        border-top: 1px solid #cbd5e1;\r\n        font-size: 8px;\r\n        color: #64748b;\r\n        text-align: center;\r\n    }\r\n</style>\r\n\r\n<div class=\"df-header\">\r\n    <div class=\"df-company\">DIVINE FOODS</div>\r\n    <div class=\"df-title\">Incident Register</div>\r\n    <div class=\"df-subtitle\">\r\n        Food Safety, Hygiene &amp; Workplace Incident Record\r\n    </div>\r\n</div>\r\n\r\n<div class=\"df-section\">Incident Information</div>\r\n\r\n<table class=\"df-info\">\r\n    <tr>\r\n        <td class=\"df-label\">Incident ID</td>\r\n        <td>{{ doc.name }}</td>\r\n\r\n        <td class=\"df-label\">Incident Date</td>\r\n        <td>{{ frappe.utils.formatdate(doc.incident_date) if doc.incident_date else \"\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"df-label\">Incident Type</td>\r\n        <td>{{ doc.incident_type or \"\" }}</td>\r\n\r\n        <td class=\"df-label\">Status</td>\r\n        <td>{{ doc.status or \"\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"df-label\">Area</td>\r\n        <td>{{ doc.area or \"\" }}</td>\r\n\r\n        <td class=\"df-label\">Reported By</td>\r\n        <td>{{ doc.reported_by or \"\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"df-label\">Person Involved</td>\r\n        <td>{{ doc.person_involved or \"\" }}</td>\r\n\r\n        <td class=\"df-label\">Follow Up Required</td>\r\n        <td>{{ \"Yes\" if doc.follow_up_required else \"No\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<div class=\"df-section\">Incident Description</div>\r\n\r\n<div class=\"df-box\">\r\n    {{ doc.description or \"\" }}\r\n</div>\r\n\r\n<div class=\"df-section\">Immediate Action Taken</div>\r\n\r\n<div class=\"df-box\">\r\n    {{ doc.immediate_action or \"No immediate action recorded.\" }}\r\n</div>\r\n\r\n<div class=\"df-section\">Follow-Up / Investigation</div>\r\n\r\n<div class=\"df-box\">\r\n    {{ doc.follow_up_details or \"No follow-up details recorded.\" }}\r\n</div>\r\n\r\n<table class=\"df-signatures\">\r\n    <tr>\r\n        <td>\r\n            <div class=\"df-sign-line\"></div>\r\n            Reported By\r\n        </td>\r\n        <td>\r\n            <div class=\"df-sign-line\"></div>\r\n            Reviewed By\r\n        </td>\r\n        <td>\r\n            <div class=\"df-sign-line\"></div>\r\n            Closed / Approved By\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<div class=\"df-footer\">\r\n    Incident Register \u00b7 Divine Foods \u00b7 Generated from ERPNext\r\n</div>",
