  "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 12mm;\r\n    }\r\n\r\n    .df-header {\r\n        border-bottom: 3px solid #0f766e;\r\n        padding-bottom: 10px;\r\n        margin-bottom: 18px;\r\n    }\r\n\r\n    .df-company {\r\n        font-size: 22px;\r\n        font-weight: 800;\r\n        color: #123047;\r\n        letter-spacing: 1px;\r\n    }\r\n\r\n    .df-title {\r\n        font-size: 16px;\r\n        font-weight: 700;\r\n        color: #0f766e;\r\n        margin-top: 4px;\r\n    }\r\n\r\n    .df-subtitle {\r\n        font-size: 9px;\r\n        color: #64748b;\r\n        margin-top: 3px;\r\n    }\r\n\r\n    .df-section {\r\n        background: #123047;\r\n        color: white;\r\n        padding: 7px 10px;\r\n        font-size: 10px;\r\n        font-weight: 700;\r\n        margin-top: 15px;\r\n        margin-bottom: 8px;\r\n        text-transform: uppercase;\r\n        letter-spacing: .5px;\r\n    }\r\n\r\n    .df-info {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .df-info td {\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px;\r\n        font-size: 9px;\r\n    }\r\n\r\n    .df-label {\r\n        font-weight: 700;\r\n        color: #475569;\r\n        width: 20%;\r\n        background: #f8fafc;\r\n    }\r\n\r\n    .df-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 8.5px;\r\n    }\r\n\r\n    .df-table th {\r\n        background: #e6f4f2;\r\n        color: #123047;\r\n        border: 1px solid #b8d7d3;\r\n        padding: 7px 5px;\r\n        font-weight: 700;\r\n        text-align: left;\r\n    }\r\n\r\n    .df-table td {\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px 5px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .df-status {\r\n        text-align: center;\r\n        font-weight: 700;\r\n    }\r\n\r\n    .df-signatures {\r\n        width: 100%;\r\n        margin-top: 35px;\r\n    }\r\n\r\n    .df-signatures td {\r\n        width: 33.33%;\r\n        text-align: center;\r\n        font-size: 8px;\r\n        color: #475569;\r\n        padding-top: 25px;\r\n    }\r\n\r\n    .df-sign-line {\r\n        border-top: 1px solid #64748b;\r\n        margin: 0 15px 5px;\r\n    }\r\n\r\n    .df-footer {\r\n        margin-top: 25px;\r\n        padding-top: 8px;\r\n        border-top: 1px solid #cbd5e1;\r\n        font-size: 8px;\r\n        color: #64748b;\r\n        text-align: center;\r\n    }\r\n</style>\r\n\r\n<div class=\"df-header\">\r\n    <div class=\"df-company\">DIVINE FOODS</div>\r\n    <div class=\"df-title\">Training Attendance Register</div>\r\n    <div class=\"df-subtitle\">\r\n        Staff Training &amp; Competency Record\r\n    </div>\r\n</div>\r\n\r\n<div class=\"df-section\">Training Information</div>\r\n\r\n<table class=\"df-info\">\r\n    <tr>\r\n        <td class=\"df-label\">Training Date</td>\r\n        <td>{{ frappe.utils.formatdate(doc.training_date) if doc.training_date else \"\" }}</td>\r\n\r\n        <td class=\"df-label\">Training Topic</td>\r\n        <td>{{ doc.training_topic or \"\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"df-label\">Trainer</td>\r\n        <td>{{ doc.trainer or \"\" }}</td>\r\n\r\n        <td class=\"df-label\">Training Type</td>\r\n        <td>{{ doc.training_type or \"\" }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"df-label\">Location</td>\r\n        <td>{{ doc.location or \"\" }}</td>\r\n\r\n        <td class=\"df-label\">Record ID</td>\r\n        <td>{{ doc.name }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<div class=\"df-section\">Attendance</div>\r\n\r\n<table class=\"df-table\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width: 10%;\">No.</th>\r\n            <th style=\"width: 45%;\">Employee</th>\r\n            <th style=\"width: 20%;\">Attendance</th>\r\n            <th style=\"width: 25%;\">Remarks</th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n        {% for row in doc.attendance %}\r\n        <tr>\r\n            <td>{{ loop.index }}</td>\r\n            <td>\r\n                {% if row.employee %}\r\n                    {{ frappe.db.get_value(\"Employee\", row.employee, \"employee_name\") or row.employee }}\r\n                {% endif %}\r\n            </td>\r\n            <td class=\"df-status\">{{ row.attendance or \"\" }}</td>\r\n            <td>{{ row.remarks or \"\" }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n{% if not doc.attendance %}\r\n<div style=\"font-size:9px; color:#64748b; padding:10px; border:1px solid #d9e2e8;\">\r\n    No attendance records have been added.\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"df-section\">Training Remarks</div>\r\n\r\n<div style=\"border:1px solid #d9e2e8; padding:10px; min-height:50px; font-size:9px;\">\r\n    {{ doc.remarks or \"No additional remarks recorded.\" }}\r\n</div>\r\n\r\n<table class=\"df-signatures\">\r\n    <tr>\r\n        <td>\r\n            <div class=\"df-sign-line\"></div>\r\n            Trainer\r\n        </td>\r\n        <td>\r\n            <div class=\"df-sign-line\"></div>\r\n            Reviewed By\r\n        </td>\r\n        <td>\r\n            <div class=\"df-sign-line\"></div>\r\n            Approved By\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<div class=\"df-footer\">\r\n    Training Attendance Register \u00b7 Divine Foods \u00b7 Generated from ERPNext\r\n</div>",
