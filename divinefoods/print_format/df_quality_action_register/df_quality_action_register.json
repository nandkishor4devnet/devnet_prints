  "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 12mm;\r\n    }\r\n\r\n    .df-header {\r\n        border-bottom: 3px solid #0f766e;\r\n        padding-bottom: 10px;\r\n        margin-bottom: 18px;\r\n    }\r\n\r\n    .df-company {\r\n        font-size: 22px;\r\n        font-weight: 800;\r\n        color: #123047;\r\n        letter-spacing: 1px;\r\n    }\r\n\r\n    .df-title {\r\n        font-size: 16px;\r\n        font-weight: 700;\r\n        color: #0f766e;\r\n        margin-top: 4px;\r\n    }\r\n\r\n    .df-subtitle {\r\n        font-size: 9px;\r\n        color: #64748b;\r\n        margin-top: 3px;\r\n    }\r\n\r\n    .df-section {\r\n        background: #123047;\r\n        color: white;\r\n        padding: 7px 10px;\r\n        font-size: 10px;\r\n        font-weight: 700;\r\n        margin-top: 15px;\r\n        margin-bottom: 8px;\r\n        text-transform: uppercase;\r\n        letter-spacing: .5px;\r\n    }\r\n\r\n    .df-info {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .df-action-summary th {\r\n        width: 25%;\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px;\r\n        font-size: 9px;\r\n        text-align: left;\r\n        color: #475569;\r\n        background: #f8fafc;\r\n    }\r\n\r\n    .df-action-summary td {\r\n        width: 25%;\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px;\r\n        font-size: 9px;\r\n        vertical-align: top;\r\n        overflow-wrap: anywhere;\r\n    }\r\n\r\n    .df-info td {\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px;\r\n        font-size: 10px;\r\n    }\r\n\r\n    .df-label {\r\n        font-weight: 700;\r\n        color: #475569;\r\n        width: 20%;\r\n        background: #f8fafc;\r\n    }\r\n\r\n    .df-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 9px;\r\n    }\r\n\r\n    .df-table th {\r\n        background: #e6f4f2;\r\n        color: #123047;\r\n        border: 1px solid #b8d7d3;\r\n        padding: 7px 5px;\r\n        font-weight: 700;\r\n        text-align: left;\r\n    }\r\n\r\n    .df-table td {\r\n        border: 1px solid #d9e2e8;\r\n        padding: 7px 5px;\r\n        vertical-align: top;\r\n        overflow-wrap: anywhere;\r\n    }\r\n\r\n    .df-status {\r\n        font-weight: 700;\r\n        text-align: center;\r\n    }\r\n\r\n    .df-problem {\r\n        font-size: 9px;\r\n        line-height: 1.45;\r\n        white-space: normal;\r\n    }\r\n\r\n    .df-resolution {\r\n        font-size: 9px;\r\n        line-height: 1.45;\r\n        white-space: normal;\r\n    }\r\n\r\n    .df-footer {\r\n        margin-top: 28px;\r\n        padding-top: 8px;\r\n        border-top: 1px solid #cbd5e1;\r\n        font-size: 8px;\r\n        color: #64748b;\r\n        text-align: center;\r\n    }\r\n\r\n    .df-signatures {\r\n        width: 100%;\r\n        margin-top: 32px;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n    }\r\n\r\n    .df-signatures td {\r\n        width: 50%;\r\n        text-align: left;\r\n        vertical-align: bottom;\r\n        font-size: 9px;\r\n        color: #475569;\r\n        padding: 12px 22px 0 0;\r\n    }\r\n\r\n    .df-sign-title {\r\n        font-weight: 700;\r\n        margin-bottom: 15px;\r\n    }\r\n\r\n    .df-sign-line {\r\n        border-top: 1px solid #64748b;\r\n        height: 1px;\r\n    }\r\n\r\n    .df-sign-date {\r\n        margin-top: 9px;\r\n    }\r\n\r\n    .df-sign-date-line {\r\n        display: inline-block;\r\n        width: 95px;\r\n        border-bottom: 1px solid #64748b;\r\n        margin-left: 5px;\r\n    }\r\n\r\n</style>\r\n\r\n<div class=\"df-header\">\r\n    <div class=\"df-company\">DIVINE FOODS</div>\r\n    <div class=\"df-title\">Quality Action / CAPA Register</div>\r\n    <div class=\"df-subtitle\">\r\n        Corrective &amp; Preventive Action Record\r\n    </div>\r\n</div>\r\n\r\n<div class=\"df-section\">Action Information</div>\r\n\r\n<table class=\"df-info df-action-summary\">\r\n    <thead>\r\n        <tr>\r\n            <th scope=\"col\">Action ID</th>\r\n            <th scope=\"col\">Date</th>\r\n            <th scope=\"col\">Action Type</th>\r\n            <th scope=\"col\">Status</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        <tr>\r\n            <td>{{ doc.name }}</td>\r\n            <td>{{ frappe.utils.formatdate(doc.date) if doc.date else \"\" }}</td>\r\n            <td>{{ doc.corrective_preventive or \"\" }}</td>\r\n            <td>{{ doc.status or \"\" }}</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n{% if doc.goal or doc.procedure or doc.review or doc.feedback %}\r\n<div class=\"df-section\">Action Details</div>\r\n\r\n<table class=\"df-info\">\r\n    <tbody>\r\n        {% if doc.goal %}\r\n        <tr><td class=\"df-label\">Goal</td><td>{{ doc.goal }}</td></tr>\r\n        {% endif %}\r\n        {% if doc.procedure %}\r\n        <tr><td class=\"df-label\">Procedure</td><td>{{ doc.procedure }}</td></tr>\r\n        {% endif %}\r\n        {% if doc.review %}\r\n        <tr><td class=\"df-label\">Review</td><td>{{ doc.review }}</td></tr>\r\n        {% endif %}\r\n        {% if doc.feedback %}\r\n        <tr><td class=\"df-label\">Feedback</td><td>{{ doc.feedback }}</td></tr>\r\n        {% endif %}\r\n    </tbody>\r\n</table>\r\n{% endif %}\r\n\r\n<div class=\"df-section\">Problem &amp; Resolution</div>\r\n\r\n<table class=\"df-table\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width: 11%;\">Incident / Date Observed</th>\r\n            <th style=\"width: 17%;\">Problem</th>\r\n            <th style=\"width: 18%;\">Root Cause</th>\r\n            <th style=\"width: 25%;\">Action / Resolution</th>\r\n            <th style=\"width: 9%;\">Status</th>\r\n            <th style=\"width: 11%;\">Responsible</th>\r\n            <th style=\"width: 9%;\">Target Date</th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n        {% for row in doc.resolutions %}\r\n        <tr>\r\n            <td>{{ frappe.utils.formatdate(row.incident_date) if row.incident_date else \"\" }}</td>\r\n\r\n            <td class=\"df-problem\">{{ row.problem or \"\" }}</td>\r\n\r\n            <td class=\"df-problem\">{{ row.root_cause or \"\" }}</td>\r\n\r\n            <td class=\"df-resolution\">{{ row.resolution or \"\" }}</td>\r\n\r\n            <td class=\"df-status\">{{ row.status or \"\" }}</td>\r\n\r\n            <td>\r\n                {% if row.responsible %}\r\n                    {{ frappe.db.get_value(\"User\", row.responsible, \"full_name\") or row.responsible }}\r\n                {% else %}\r\n                    Not assigned\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td>{{ frappe.utils.formatdate(row.completion_by) if row.completion_by else \"\" }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n{% if not doc.resolutions %}\r\n<div style=\"font-size:9px; color:#64748b; padding:10px; border:1px solid #d9e2e8;\">\r\n    No corrective/preventive action resolutions have been recorded.\r\n</div>\r\n{% endif %}\r\n\r\n<table class=\"df-signatures\">\r\n    <tbody>\r\n        <tr>\r\n            <td>\r\n                <div class=\"df-sign-title\">HACCP Team Leader</div>\r\n                <div class=\"df-sign-line\"></div>\r\n                <div class=\"df-sign-date\">Date:<span class=\"df-sign-date-line\"></span></div>\r\n            </td>\r\n            <td>\r\n                <div class=\"df-sign-title\">Verified / Closed By</div>\r\n                <div class=\"df-sign-line\"></div>\r\n                <div class=\"df-sign-date\">Date:<span class=\"df-sign-date-line\"></span></div>\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<div class=\"df-footer\">\r\n    Quality Action / CAPA Register \u00b7 Divine Foods \u00b7 Generated from ERPNext\r\n</div>",
