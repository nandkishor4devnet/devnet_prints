  "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 12mm 13mm;\r\n    }\r\n\r\n    * {\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    body {\r\n        margin: 0;\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        color: #263746;\r\n        font-size: 9px;\r\n        line-height: 1.4;\r\n        background: #ffffff;\r\n    }\r\n\r\n    .page {\r\n        width: 100%;\r\n    }\r\n\r\n    .header {\r\n        display: table;\r\n        width: 100%;\r\n        border-bottom: 3px solid #1f7f7a;\r\n        padding-bottom: 9px;\r\n        margin-bottom: 12px;\r\n    }\r\n\r\n    .header-left {\r\n        display: table-cell;\r\n        width: 72%;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .header-right {\r\n        display: table-cell;\r\n        width: 28%;\r\n        text-align: right;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .company {\r\n        font-size: 21px;\r\n        font-weight: 700;\r\n        color: #17384d;\r\n        letter-spacing: .4px;\r\n    }\r\n\r\n    .title {\r\n        font-size: 15px;\r\n        font-weight: 700;\r\n        color: #187a76;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .subtitle {\r\n        font-size: 8px;\r\n        color: #71808c;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .doc-label {\r\n        font-size: 7px;\r\n        color: #91a0aa;\r\n        text-transform: uppercase;\r\n        letter-spacing: 1px;\r\n        font-weight: 700;\r\n    }\r\n\r\n    .doc-ref {\r\n        font-size: 11px;\r\n        font-weight: 700;\r\n        color: #172c3d;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .badge {\r\n        display: inline-block;\r\n        margin-top: 6px;\r\n        padding: 4px 9px;\r\n        border: 1px solid #b8cece;\r\n        background: #edf6f5;\r\n        color: #246a67;\r\n        font-size: 8px;\r\n        font-weight: 700;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .notice {\r\n        border-left: 4px solid #d4a72c;\r\n        background: #fbf7eb;\r\n        padding: 7px 9px;\r\n        margin-bottom: 12px;\r\n        color: #6d5b29;\r\n        font-size: 8px;\r\n    }\r\n\r\n    .section {\r\n        margin-top: 12px;\r\n        margin-bottom: 6px;\r\n        border-bottom: 2px solid #b9d1d2;\r\n        padding-bottom: 4px;\r\n        color: #3e5c6d;\r\n        font-size: 9px;\r\n        font-weight: 700;\r\n        text-transform: uppercase;\r\n        letter-spacing: .8px;\r\n    }\r\n\r\n    .info-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .info-table td {\r\n        padding: 5px 6px;\r\n        border-bottom: 1px solid #dfe7ea;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .label {\r\n        width: 18%;\r\n        color: #758692;\r\n        font-size: 7px;\r\n        text-transform: uppercase;\r\n        font-weight: 700;\r\n        letter-spacing: .5px;\r\n    }\r\n\r\n    .value {\r\n        width: 32%;\r\n        color: #263746;\r\n        font-weight: 600;\r\n    }\r\n\r\n    .cert-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        table-layout: fixed;\r\n        font-size: 7.8px;\r\n    }\r\n\r\n    .cert-table th {\r\n        background: #edf4f5;\r\n        color: #48606d;\r\n        border: 1px solid #cbdcdf;\r\n        padding: 6px 5px;\r\n        text-align: left;\r\n        font-size: 7px;\r\n        text-transform: uppercase;\r\n        letter-spacing: .3px;\r\n        font-weight: 700;\r\n    }\r\n\r\n    .cert-table td {\r\n        border: 1px solid #d5e0e3;\r\n        padding: 6px 5px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .status-valid {\r\n        font-weight: 700;\r\n        color: #23705f;\r\n    }\r\n\r\n    .status-soon {\r\n        font-weight: 700;\r\n        color: #9a761f;\r\n    }\r\n\r\n    .status-expired {\r\n        font-weight: 700;\r\n        color: #a64b43;\r\n    }\r\n\r\n    .status-none {\r\n        font-weight: 700;\r\n        color: #7b8790;\r\n    }\r\n\r\n    .detail-box {\r\n        border-left: 3px solid #9fc4c3;\r\n        padding: 6px 9px;\r\n        margin-top: 3px;\r\n        color: #435663;\r\n        font-size: 8px;\r\n        min-height: 32px;\r\n    }\r\n\r\n    .signatures {\r\n        width: 100%;\r\n        margin-top: 33px;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .signatures td {\r\n        width: 33.33%;\r\n        text-align: center;\r\n        padding-top: 17px;\r\n        color: #647480;\r\n        font-size: 7px;\r\n    }\r\n\r\n    .sign-line {\r\n        border-top: 1px solid #9aa9b2;\r\n        margin: 0 12px 5px;\r\n    }\r\n\r\n    .footer {\r\n        margin-top: 12px;\r\n        padding-top: 7px;\r\n        border-top: 1px solid #d5dfe2;\r\n        color: #87939b;\r\n        font-size: 6.8px;\r\n        text-align: left;\r\n    }\r\n</style>\r\n\r\n{% set ns = namespace(overall=\"No Certificate\") %}\r\n\r\n{% if doc.custom_certification %}\r\n    {% set ns.overall = \"Valid\" %}\r\n    {% for row in doc.custom_certification %}\r\n        {% if row.certification_expiry_date %}\r\n            {% set days = frappe.utils.date_diff(row.certification_expiry_date, frappe.utils.nowdate()) %}\r\n            {% if days < 0 %}\r\n                {% set ns.overall = \"Expired\" %}\r\n            {% elif days <= 30 and ns.overall != \"Expired\" %}\r\n                {% set ns.overall = \"Expiring Soon\" %}\r\n            {% endif %}\r\n        {% endif %}\r\n    {% endfor %}\r\n{% endif %}\r\n\r\n<div class=\"page\">\r\n\r\n    <div class=\"header\">\r\n        <div class=\"header-left\">\r\n            <div class=\"company\">DIVINE FOODS</div>\r\n            <div class=\"title\">Supplier Certification Register</div>\r\n            <div class=\"subtitle\">Supplier certification and compliance document record</div>\r\n        </div>\r\n\r\n        <div class=\"header-right\">\r\n            <div class=\"doc-label\">Document Reference</div>\r\n            <div class=\"doc-ref\">{{ doc.name }}</div>\r\n            <div class=\"badge\">{{ ns.overall }}</div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"notice\">\r\n        Supplier certification record maintained for compliance, supplier approval and audit traceability.\r\n    </div>\r\n\r\n    <div class=\"section\">Supplier Information</div>\r\n\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td class=\"label\">Supplier</td>\r\n            <td class=\"value\">{{ doc.supplier_name or \"\" }}</td>\r\n\r\n            <td class=\"label\">Supplier Type</td>\r\n            <td class=\"value\">{{ doc.supplier_type or \"\" }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"label\">Supplier Group</td>\r\n            <td class=\"value\">{{ doc.supplier_group or \"\" }}</td>\r\n\r\n            <td class=\"label\">Country</td>\r\n            <td class=\"value\">{{ doc.country or \"\" }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td class=\"label\">Tax ID</td>\r\n            <td class=\"value\">{{ doc.tax_id or \"\" }}</td>\r\n\r\n            <td class=\"label\">Record ID</td>\r\n            <td class=\"value\">{{ doc.name }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"section\">Certification Details</div>\r\n\r\n    {% if doc.custom_certification %}\r\n\r\n    <table class=\"cert-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:18%;\">Certification Type</th>\r\n                <th style=\"width:16%;\">Certificate No.</th>\r\n                <th style=\"width:20%;\">Issuing Authority</th>\r\n                <th style=\"width:13%;\">Start Date</th>\r\n                <th style=\"width:13%;\">Expiry Date</th>\r\n                <th style=\"width:20%;\">Status</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for row in doc.custom_certification %}\r\n                {% set row_status = \"No Expiry Date\" %}\r\n                {% set row_class = \"status-none\" %}\r\n\r\n                {% if row.certification_expiry_date %}\r\n                    {% set days = frappe.utils.date_diff(row.certification_expiry_date, frappe.utils.nowdate()) %}\r\n\r\n                    {% if days < 0 %}\r\n                        {% set row_status = \"Expired\" %}\r\n                        {% set row_class = \"status-expired\" %}\r\n                    {% elif days <= 30 %}\r\n                        {% set row_status = \"Expiring Soon\" %}\r\n                        {% set row_class = \"status-soon\" %}\r\n                    {% else %}\r\n                        {% set row_status = \"Valid\" %}\r\n                        {% set row_class = \"status-valid\" %}\r\n                    {% endif %}\r\n                {% endif %}\r\n\r\n                <tr>\r\n                    <td>{{ row.certification_type or \"\" }}</td>\r\n                    <td>{{ row.certification_number or \"\" }}</td>\r\n                    <td>{{ row.issuing_authority or \"\" }}</td>\r\n                    <td>\r\n                        {{ frappe.utils.formatdate(row.certification_start_date)\r\n                           if row.certification_start_date else \"\" }}\r\n                    </td>\r\n                    <td>\r\n                        {{ frappe.utils.formatdate(row.certification_expiry_date)\r\n                           if row.certification_expiry_date else \"\" }}\r\n                    </td>\r\n                    <td class=\"{{ row_class }}\">{{ row_status }}</td>\r\n                </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    {% else %}\r\n\r\n    <div class=\"detail-box\">\r\n        No supplier certification records have been entered.\r\n    </div>\r\n\r\n    {% endif %}\r\n\r\n    <div class=\"section\">Additional Recorded Details</div>\r\n\r\n    <div class=\"detail-box\">\r\n        Supplier certification information should be reviewed against current supplier approval,\r\n        certificate validity and supporting documentation before audit or approval.\r\n    </div>\r\n\r\n    <table class=\"signatures\">\r\n        <tr>\r\n            <td>\r\n                <div class=\"sign-line\"></div>\r\n                Prepared by \u00b7 Signature / Date\r\n            </td>\r\n\r\n            <td>\r\n                <div class=\"sign-line\"></div>\r\n                Reviewed by \u00b7 Signature / Date\r\n            </td>\r\n\r\n            <td>\r\n                <div class=\"sign-line\"></div>\r\n                Approved by \u00b7 Signature / Date\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"footer\">\r\n        {{ doc.name }} \u00b7 Supplier Certification Register \u00b7 Last generated {{ frappe.utils.now_datetime() }} \u00b7 Divine Foods\r\n    </div>\r\n\r\n</div>",
